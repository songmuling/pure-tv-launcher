<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6080B10">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_update_bg"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- 头部：应用图标 + 应用名称 + 类型标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/appDetailIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/appDetailType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FF74A987"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#26FFFFFF" />

        <!-- 详情卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14FFFFFF"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- 包名 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_details_package"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:id="@+id/appDetailPackage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- 版本 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_details_version"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:id="@+id/appDetailVersion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- 安装大小 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_details_size"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:id="@+id/appDetailSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- 更新时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_details_updated"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:id="@+id/appDetailTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>
        </LinearLayout>

        <!-- 按钮交互区 -->
        <LinearLayout
            android:id="@+id/appDetailButtonSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAppOpen"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/dialog_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/app_details_btn_open"
                android:textColor="@color/dialog_btn_text"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/btnAppManage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/dialog_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/app_details_btn_manage"
                android:textColor="@color/dialog_btn_text"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/btnAppUninstall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/dialog_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/app_details_btn_uninstall"
                android:textColor="@color/dialog_btn_text"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/btnAppClose"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/dialog_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/app_details_btn_close"
                android:textColor="@color/dialog_btn_text"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
