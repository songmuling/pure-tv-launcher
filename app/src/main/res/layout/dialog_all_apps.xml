<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6080B10"
    android:paddingStart="56dp"
    android:paddingEnd="56dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_apps"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/allAppsFocusedName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FF74A987"
                android:textSize="22sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/allAppsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_apps_action_hint"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
